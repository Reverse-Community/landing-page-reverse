{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "reverse-community",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "reverse-community-db",
      "database_id": "DATABASE_ID",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "REVERSE_KV",
      "id": "KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "reverse-community-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "reverse-community-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "reverse-community"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "env": {
    "production": {
      "name": "reverse-community",
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "reverse-community-db",
          "database_id": "DATABASE_ID",
          "remote": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "REVERSE_KV",
          "id": "KV_NAMESPACE_ID"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "reverse-community-media"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "reverse-community-cache"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "reverse-community"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
