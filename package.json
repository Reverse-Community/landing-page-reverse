{
  "name": "reverse-community",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload",
    "migrate": "cross-env PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload migrate",
    "migrate:fresh": "cross-env PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload migrate:fresh",
    "migrate:create": "cross-env PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload migrate:create",
    "migrate:status": "cross-env PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload migrate:status",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --remote",
    "deploy:app": "opennextjs-cloudflare build --env=$CLOUDFLARE_ENV && opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV",
    "deploy": "pnpm run deploy:database && pnpm run deploy:app",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env=$CLOUDFLARE_ENV",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@payloadcms/db-d1-sqlite": "^3.85.2",
    "@payloadcms/db-sqlite": "^3.85.2",
    "@payloadcms/graphql": "^3.85.2",
    "@payloadcms/next": "^3.85.2",
    "@payloadcms/storage-r2": "^3.85.2",
    "@payloadcms/translations": "^3.85.2",
    "@payloadcms/ui": "^3.85.2",
    "cli-color": "^2.0.4",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "lucide-react": "^0.468.0",
    "next": "^16.2.2",
    "payload": "^3.85.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@payloadcms/drizzle": "^3.85.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.2.2",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "wrangler": "^4.108.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@next/env": "$next"
  }
}
