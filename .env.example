# ========================================
# Reverse Community — Dual Deployment
# ========================================
#
# Two modes:
#
#   VPS mode  → set DATABASE_URL to a SQLite file path
#               (e.g. DATABASE_URL=file:./reverse-community.db)
#               Uses @payloadcms/db-sqlite + local file uploads
#               Run with: next start
#
#   Cloudflare → leave DATABASE_URL unset
#               Uses D1 binding + KV (no R2)
#               Deploy with: opennextjs-cloudflare build && wrangler deploy
#

# Public site URL (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://reverse.my.id

# Discord invite link
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/FpTcm5VYTt

# Discord server ID (for widget stats fallback)
DISCORD_GUILD_ID=1065486356513554522

# CMS content: set to "true" to load from Payload CMS (D1 database)
# When disabled, uses static fallback data from src/data/community.ts
ENABLE_CMS_CONTENT=false

# Payload CMS admin secret (generate with: openssl rand -hex 32)
# Required in production
PAYLOAD_SECRET=reverse-community-dev-secret-change-me

# Admin protection
# Payload CMS has its own login. For extra production protection, use
# Cloudflare Access (Cloudflare) or reverse-proxy basic auth (VPS/Caddy).

# Umami analytics (optional)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Internal ecosystem API token (for bot heartbeat & guild snapshot)
# Use the same value in bot env files
INTERNAL_API_TOKEN=change-this-to-a-long-random-internal-token

# ========================================
# VPS / Node.js SQLite mode
# ========================================
#
# Set this to a SQLite file path to run on VPS/local Node.js.
# Leave unset to use Cloudflare D1 mode.
#
# Examples:
#   DATABASE_URL=file:./reverse-community.db         # relative to cwd
#   DATABASE_URL=file:/data/reverse-community.db      # absolute path
#
# DATABASE_URL=file:./reverse-community.db

# ========================================
# Cloudflare-specific
# ========================================
#
# Cloudflare environment (e.g., "production", "staging")
# Used by deploy scripts: pnpm run deploy --env=$CLOUDFLARE_ENV
#
CLOUDFLARE_ENV=production

# Database (D1) and KV are configured via
# Cloudflare bindings in wrangler.jsonc — not through .env variables.
# Run `pnpm run cf-typegen` after changing wrangler.jsonc bindings.
